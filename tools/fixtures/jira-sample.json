        "updated": "2026-08-12T08:21:19.000+0000",
        "labels": ["payouts", "reliability"],
        "components": [{ "id": "10300", "name": "payout-service" }],
        "fixVersions": [{ "id": "10400", "name": "2026.9" }],
        "customfield_10016": 5,
        "customfield_10020": [{ "id": 812, "name": "Payouts Sprint 14", "state": "active" }],
        "attachment": [
          { "id": "20001", "filename": "failed-batch-2026-07-30.csv", "size": 40122, "author": { "displayName": "Marta Okonjo" } }
        ],
        "issuelinks": [
          { "id": "30001", "type": { "name": "Blocks", "inward": "is blocked by", "outward": "blocks" }, "outwardIssue": { "key": "HELIO-21" } }
        ],
        "watches": { "watchCount": 4, "isWatching": false },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "A batch of 400 transfers currently fails as a unit. One declined card means the other 399 are replayed, and the processor charges us for every replay." }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "Acceptance:" }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    { "type": "paragraph", "content": [{ "type": "text", "text": "A transfer carries its own state and can be retried alone." }] }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    { "type": "paragraph", "content": [{ "type": "text", "text": "A retry is idempotent on the processor reference." }] }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "Runbook updated: " },
                        { "type": "text", "text": "payout retries", "marks": [{ "type": "link", "attrs": { "href": "https://docs.example.com/runbooks/payout-retries" } }] }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "codeBlock",
              "attrs": { "language": "sql" },
              "content": [
                { "type": "text", "text": "SELECT id, state FROM transfers WHERE batch_id = ? AND state <> 'settled';" }
              ]
            }
          ]
        },
        "comment": {
          "startAt": 0,
          "maxResults": 2,
          "total": 2,
          "comments": [
            {
              "id": "40001",
              "self": "https://jira.example.com/rest/api/3/issue/10014/comment/40001",
              "author": { "accountId": "c72d99f110", "displayName": "Devan Ruiz", "emailAddress": "devan.ruiz@example.com" },
              "created": "2026-07-31T10:05:00.000+0000",
              "updated": "2026-07-31T10:05:00.000+0000",
              "body": {
                "type": "doc",
                "version": 1,
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      { "type": "text", "text": "The processor reference is unique per attempt, not per transfer, so idempotency has to key off our own transfer id." }
                    ]
                  }
                ]
              }
            },
            {
              "id": "40002",
              "self": "https://jira.example.com/rest/api/3/issue/10014/comment/40002",
              "author": { "accountId": "a91b4402ee", "displayName": "Marta Okonjo", "emailAddress": "marta.okonjo@example.com" },
              "created": "2026-08-01T14:22:41.000+0000",
              "updated": "2026-08-01T14:22:41.000+0000",
              "body": {
                "type": "doc",
                "version": 1,
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      { "type": "mention", "attrs": { "id": "c72d99f110", "text": "@Devan Ruiz" } },
                      { "type": "text", "text": " agreed. Keying off the transfer id now, sandbox run attached." }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
