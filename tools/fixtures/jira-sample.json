        "status": { "name": "In Progress", "statusCategory": { "id": 4, "key": "indeterminate", "name": "In Progress" } },
        "priority": { "id": "2", "name": "High" },
        "assignee": { "accountId": "a91b4402ee", "displayName": "Marta Okonjo", "emailAddress": "marta.okonjo@example.com" },
