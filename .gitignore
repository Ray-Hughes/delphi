node_modules/

# Installer output. Rebuilt from a tag by the release workflow, and a single mac
# dmg is over a hundred megabytes, so it is never committed.
release/

# The database is personal work content, not code. It was tracked here as
# brain.db once, that name stopped matching the file after the rename to
# delphi.db, and a populated database reached this public repository as a
# result. Both names are listed so an older clone is covered too.
delphi.db
delphi.db-wal
delphi.db-shm
brain.db
brain.db-wal
brain.db-shm

# Personal seeding scripts. These carry real note content from the work they were
# written to load, and that content is already in the database, so they are kept
# on disk but never committed. Anyone else starts from an empty tracker.
seed_memory.js
import.py

settings.json
vault/

# Sheet run logs. They live in DATA_DIR, which from a checkout is the checkout
# itself, so without this every command an agent ran would be one `git add .`
# from the repository, output, secrets in environment dumps and all. Anchored to
# the root because tools/fixtures/sheets/ holds test fixtures that are committed.
/sheets/
