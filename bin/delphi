#!/usr/bin/env node
/**
 * delphi: a task's Sheet from the shell.
 *
 * Talks to agent/mcp_server.js over stdio rather than opening the database
 * itself, for the reasons the queue runner does: the Sheet's rules and the
 * audit trail live in one place, and this runs under any Node, with or
 * without node:sqlite. One server per invocation.
 *
 * Writes are attributed to DELPHI_ACTOR, which defaults to the OS username, so
 * History says which person (or which agent, when an agent shells out to this)
 * did what.
 *
 * Output is for two readers. At a terminal it carries the {} metadata, entry
 * ids above all, because those are what the next command needs. Piped, it is
 * clean text, so `delphi cat 42 | pbcopy` pastes anywhere without noise.
 */

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn } = require("child_process");

// Literal relative paths, so tools/package_test.js can follow them and fail
// when one is left out of extraResources.
const { openServer } = require("../sheet/client");
const fmt = require("../sheet/format");
const { runEntry, logPathFor } = require("../sheet/run");
const { splitCommand } = require("../agent/launch");

const HELP = {
