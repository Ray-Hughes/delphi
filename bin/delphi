    "v then y a range, p promotes, f files, Enter folds, a to d answers, r reruns, e edits, o pages, q quits.",
    "Needs a terminal at both ends.",
  ],
  cat: [
    "delphi cat <task> [--ledger] [--tail N] [--raw] [--clean]",
    "Print a task's Sheet. --ledger is only what was promoted; --tail N the last N entries.",
    "At a terminal the {} metadata (entry ids, run results) is shown; piped, the text is clean.",
