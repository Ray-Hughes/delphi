<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime is required for notarisation, and it blocks several
    things a Chromium process does as a matter of course. Each of these is the
    narrowest permission that lets Electron run under it.

    Nothing here weakens the app beyond what running V8 requires. There is no
    entitlement for the camera, the microphone, contacts or location, because
    Delphi does not touch any of them.
  -->

  <!-- V8 compiles JavaScript to machine code at runtime, which is what a JIT is. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- And it writes that code into pages it then executes. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Electron's helpers are launched with DYLD variables set. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- The framework loads libraries signed with the Electron team's identity
       rather than ours, which strict library validation refuses. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
