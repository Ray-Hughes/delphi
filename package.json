{
  "name": "delphi",
  "version": "1.2.0",
  "description": "A project tracker with a knowledge graph, that your AI agents keep current themselves",
  "main": "main.js",
  "author": "Ray Hughes",
  "license": "MIT",
  "homepage": "https://github.com/Ray-Hughes/delphi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ray-Hughes/delphi.git"
  },
  "scripts": {
    "start": "electron .",
    "icons": "python3 tools/make_icons.py",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac --config electron-builder.config.js",
    "dist:win": "electron-builder --win --config electron-builder.config.js",
    "release": "electron-builder --config electron-builder.config.js --publish always"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "productName": "Delphi"
}
